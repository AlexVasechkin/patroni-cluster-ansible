# ============================================================
# Patroni конфигурация для ноды: {{ inventory_hostname }}
# Сгенерировано Ansible — не редактировать вручную
#
# Структура файла:
#   scope / name      — идентификация кластера и ноды
#   restapi           — HTTP API Patroni (healthcheck, управление)
#   etcd3             — подключение к DCS (distributed config store)
#   bootstrap         — параметры первого запуска (initdb, pg_hba)
#   postgresql        — конфигурация самого PostgreSQL
# ============================================================

# Имя кластера — одинаковое для всех нод.
# Используется как корневой ключ в etcd: /service/<scope>/
scope: {{ patroni_cluster_name }}

# Имя этой конкретной ноды внутри кластера
name: {{ inventory_hostname }}

# ----------------------------------------------------------
# REST API
# Patroni предоставляет HTTP API для мониторинга и управления.
# HAProxy / keepalived проверяют /health чтобы понять кто primary.
# ----------------------------------------------------------
restapi:
  # Слушаем на всех интерфейсах
  listen: {{ postgresql_listen_address }}:{{ patroni_api_port }}
  # Адрес, по которому другие ноды и балансировщики видят этот API
  connect_address: {{ patroni_node_ip }}:{{ patroni_api_port }}
{% if patroni_restapi_username %}
  # Basic-auth на НЕбезопасные эндпоинты (restart/switchover/failover/reload,
  # изменение конфига). GET-эндпоинты (health/leader/replica) остаются
  # открытыми для healthcheck'ов и балансировщиков — так задумано Patroni.
  authentication:
    username: {{ patroni_restapi_username }}
    password: {{ patroni_restapi_password }}
{% endif %}

# ----------------------------------------------------------
# DCS: etcd v3 API
#
# Почему etcd3, а не etcd?
#   etcd 3.5+ отключил v2 API по умолчанию.
#   Секция `etcd3:` использует gRPC/v3 API через библиотеку etcd3.
# ----------------------------------------------------------
etcd3:
  # Список всех etcd endpoint'ов через запятую (host:port, без схемы —
  # схема задаётся ниже через protocol). Однострочный scalar намеренно:
  # folded '>-' склеивал бы следующие строки в значение при trim_blocks.
  hosts: "{% for node in etcd_nodes %}{{ node.ip }}:{{ node.client_port }}{% if not loop.last %},{% endif %}{% endfor %}"
{% if etcd_tls_enabled %}
  # Mutual TLS: ходим в etcd по https и предъявляем клиентский серт.
  protocol: https
  cacert: {{ patroni_etcd_ca_cert }}
  cert: {{ patroni_etcd_client_cert }}
  key: {{ patroni_etcd_client_key }}
{% endif %}

# ----------------------------------------------------------
# Bootstrap — выполняется ОДИН РАЗ на primary при initdb.
# Остальные ноды игнорируют этот раздел и клонируют primary.
# ----------------------------------------------------------
bootstrap:
{% if pitr_bootstrap | default(false) %}

  # ----------------------------------------------------------
  # PITR-восстановление (одноразовый bootstrap!)
  #
  # Когда DCS очищен и data_dir пуст, Patroni на первой ноде
  # выполняет этот метод ВМЕСТО initdb: pgBackRest восстанавливает
  # кластер из бэкапа и накатывает архивный WAL до момента
  # pitr_target_time, затем PostgreSQL промоутится (--target-action).
  #
  #   keep_existing_recovery_conf: pgBackRest сам пишет recovery.signal
  #     + restore_command + recovery_target_time — Patroni их не трогает.
  #   no_params: не добавлять к команде свои --scope/--datadir и т.п.
  #
  # ВАЖНО: после успешного восстановления этот блок нужно убрать
  # (playbook 05 перегенерирует конфиг с pitr_bootstrap=false), иначе
  # при следующем ре-бутстрапе Patroni снова уйдёт в PITR.
  # ----------------------------------------------------------
  method: pgbackrest_pitr
  pgbackrest_pitr:
    command: >-
      pgbackrest --stanza={{ pgbackrest_stanza }} --delta
      --type=time --target="{{ pitr_target_time }}"
      --target-action=promote restore
    keep_existing_recovery_conf: True
    no_params: True
{% endif %}

  # Параметры кластера, которые Patroni хранит в etcd.
  # Применяются ко всем нодам (включая будущие реплики).
  dcs:
    # Время жизни лидерского ключа в etcd (секунды).
    # Если primary не обновляет ключ дольше ttl — запускается failover.
    ttl: {{ patroni_ttl }}

    # Интервал главного цикла Patroni (секунды).
    # Каждые loop_wait секунд Patroni проверяет состояние кластера.
    loop_wait: {{ patroni_loop_wait }}

    # Таймаут на операции с etcd.
    # Должен быть >= loop_wait.
    retry_timeout: {{ patroni_retry_timeout }}

    # Максимальное отставание реплики при failover (байты).
    # Если реплика отстала больше — она не получит роль primary.
    # 1048576 = 1MB
    maximum_lag_on_failover: {{ patroni_maximum_lag_on_failover }}

    postgresql:
      # pg_rewind позволяет вернуть старый primary как реплику
      # после failover без полного pg_basebackup.
      use_pg_rewind: true

      # Replication slots гарантируют что WAL не удалится
      # пока реплика не применила его.
      use_slots: true

      # Параметры PostgreSQL (применяются через patronictl edit-config)
      parameters:
        # Уровень WAL: replica = достаточно для streaming replication
        wal_level: {{ postgresql_wal_level }}
        # Разрешить чтение с hot standby реплики
        hot_standby: "{{ postgresql_hot_standby }}"
        # Реплика держит catalog_xmin на primary — без этого логический
        # слот на standby инвалидируется при vacuum. Reload, без рестарта.
        hot_standby_feedback: "{{ postgresql_hot_standby_feedback }}"
        max_connections: {{ postgresql_max_connections }}
        # Количество WAL sender процессов (для реплик)
        max_wal_senders: {{ postgresql_max_wal_senders }}
        max_replication_slots: {{ postgresql_max_replication_slots }}
        # Нужно для pg_rewind
        wal_log_hints: "{{ postgresql_wal_log_hints }}"
        shared_buffers: {{ postgresql_shared_buffers }}
{% if pgbackrest_enabled | default(false) %}
        # --- Непрерывное архивирование WAL через pgBackRest (для PITR) ---
        # archive_mode=on требует РЕСТАРТА PostgreSQL (читается только при старте).
        archive_mode: "on"
        # Каждый заполненный сегмент WAL уходит в репозиторий pgBackRest.
        archive_command: 'pgbackrest --stanza={{ pgbackrest_stanza }} archive-push %p'
        # Форсировать переключение WAL хотя бы раз в N секунд даже при простое —
        # ограничивает окно потери данных (RPO) при отсутствии записи.
        archive_timeout: {{ pgbackrest_archive_timeout | default('60s') }}
{% endif %}

  # Опции для pg_ctl initdb при создании нового кластера
  initdb:
    - encoding: UTF8
    - data-checksums    # включает checksums для обнаружения повреждений

  # pg_hba.conf — правила аутентификации PostgreSQL
  pg_hba:
    # Репликация между нодами (pg1 ↔ pg2)
    - host replication {{ patroni_replication_user }} {{ cluster_subnet }} {{ patroni_pg_hba_auth_method }}
    # Доступ приложений
    - host all all {{ patroni_pg_hba_app_cidr }} {{ patroni_pg_hba_auth_method }}
    # Локальный доступ (для patronictl, healthcheck)
    - local all all trust

  # Пользователи, создаваемые при bootstrap
  users:
    {{ patroni_replication_user }}:
      password: {{ patroni_replication_password }}
      options:
        - replication

# ----------------------------------------------------------
# PostgreSQL конфигурация для этой конкретной ноды
# ----------------------------------------------------------
postgresql:
  # На каком адресе слушает PostgreSQL
  listen: {{ postgresql_listen_address }}:{{ postgresql_port }}

  # Адрес, который Patroni передаёт в etcd для подключения других нод.
  # Важно: это должен быть реальный IP, не 0.0.0.0!
  connect_address: {{ patroni_node_ip }}:{{ postgresql_port }}

  # Директория с данными PostgreSQL.
  # Должна быть ПУСТОЙ при первом старте (Patroni сам сделает initdb).
  data_dir: {{ postgresql_data_dir }}

  # Путь к бинарникам PostgreSQL
  bin_dir: /usr/lib/postgresql/{{ postgresql_version }}/bin

  # Файл для хранения паролей (используется pg_rewind, pg_basebackup)
  pgpass: /tmp/.pgpass_{{ inventory_hostname }}
{% if pgbackrest_enabled | default(false) %}

  # ----------------------------------------------------------
  # pgBackRest — восстановление реплик и получение архивного WAL
  #
  # create_replica_methods: новые/пересобираемые реплики сначала
  # пытаются восстановиться из репозитория pgBackRest (--delta restore),
  # разгружая primary; basebackup остаётся запасным методом.
  #
  # recovery_conf.restore_command: если streaming replication отстанет,
  # реплика догонит недостающие сегменты из архива pgBackRest.
  # ----------------------------------------------------------
  create_replica_methods:
    - pgbackrest
    - basebackup
  pgbackrest:
    command: 'pgbackrest --stanza={{ pgbackrest_stanza }} --delta restore'
    keep_data: True
    no_params: True
  recovery_conf:
    restore_command: 'pgbackrest --stanza={{ pgbackrest_stanza }} archive-get %f "%p"'
{% endif %}

  # Аутентификация
  authentication:
    # Пользователь для репликации (streaming replication, pg_basebackup)
    replication:
      username: {{ patroni_replication_user }}
      password: {{ patroni_replication_password }}
    # Суперпользователь PostgreSQL
    superuser:
      username: {{ patroni_superuser }}
      password: {{ patroni_superuser_password }}
    # Пользователь для Patroni (rewind, управление)
    rewind:
      username: {{ patroni_superuser }}
      password: {{ patroni_superuser_password }}

{% if patroni_ignore_slots | default([]) %}
# ----------------------------------------------------------
# ignore_slots — слоты, которыми Patroni НЕ управляет.
# Защищает вручную созданные логические слоты (logical decoding on
# standby) от удаления при реконсиляции слотов, в т.ч. при смене лидера.
# ----------------------------------------------------------
ignore_slots:
{% for slot in patroni_ignore_slots %}
  - name: {{ slot.name }}
    type: {{ slot.type }}
{% if slot.database is defined %}
    database: {{ slot.database }}
{% endif %}
{% if slot.plugin is defined %}
    plugin: {{ slot.plugin }}
{% endif %}
{% endfor %}
{% endif %}

# ----------------------------------------------------------
# Watchdog — аппаратная защита от split-brain
# В production использовать softdog или аппаратный watchdog.
# Для обучения отключаем.
# ----------------------------------------------------------
watchdog:
  mode: {{ patroni_watchdog_mode }}

# ----------------------------------------------------------
# Теги — метаданные ноды для маршрутизации запросов
# ----------------------------------------------------------
tags:
  # true = нода никогда не станет primary при failover
  nofailover: false
  # true = нода не участвует в балансировке нагрузки
  noloadbalance: false
  # true = другие ноды не будут клонировать с этой
  clonefrom: false
  # true = нода не используется как синхронная реплика
  nosync: false
