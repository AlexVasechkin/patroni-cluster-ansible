# ============================================================
# etcd конфигурация для ноды: {{ inventory_hostname }}
# Сгенерировано Ansible — не редактировать вручную
# ============================================================

# ----------------------------------------------------------
# Идентификация ноды
# ----------------------------------------------------------

# Имя этой ноды внутри кластера.
# Должно совпадать с именем в initial-cluster (ниже).
name: '{{ inventory_hostname }}'

# Директория для хранения данных raft-лога и снапшотов
data-dir: '{{ etcd_data_dir }}'

# ----------------------------------------------------------
# Peer URLs — общение между etcd-нодами (репликация)
#
# Схема: нода-лидер получает запись от клиента → реплицирует
# её на follower-ноды через peer-канал → все подтверждают.
# ----------------------------------------------------------

# На каком адресе слушаем входящие peer-соединения.
# 0.0.0.0 — принимаем со всех интерфейсов.
listen-peer-urls: '{{ etcd_scheme }}://{{ etcd_listen_address }}:{{ etcd_peer_port }}'

# Какой URL эта нода "объявляет" другим нодам кластера.
# Должен быть реальным IP (не 0.0.0.0), т.к. другие ноды
# будут подключаться именно по этому адресу.
initial-advertise-peer-urls: '{{ etcd_scheme }}://{{ etcd_node_ip }}:{{ etcd_peer_port }}'

# ----------------------------------------------------------
# Client URLs — общение с клиентами (Patroni, etcdctl)
# ----------------------------------------------------------

# На каком адресе слушаем клиентские запросы.
listen-client-urls: '{{ etcd_scheme }}://{{ etcd_listen_address }}:{{ etcd_client_port }}'

# URL, который эта нода объявляет клиентам.
# Patroni будет подключаться именно по этому адресу.
advertise-client-urls: '{{ etcd_scheme }}://{{ etcd_node_ip }}:{{ etcd_client_port }}'

# ----------------------------------------------------------
# Параметры инициализации кластера
#
# Эти параметры используются ТОЛЬКО при первом старте.
# После инициализации etcd хранит состояние в data-dir
# и игнорирует initial-* параметры.
# ----------------------------------------------------------

# Уникальный токен кластера.
# Защищает от случайного объединения разных кластеров.
initial-cluster-token: '{{ etcd_initial_cluster_token }}'

# Список всех нод кластера при инициализации.
# Формат: name=peer-url,name=peer-url,...
#
# Jinja2 строит строку динамически из переменной etcd_nodes:
#   etcd1=http://172.20.0.11:2380,etcd2=http://172.20.0.12:2380,...
initial-cluster: >-
  {% for node in etcd_nodes -%}
  {{ node.name }}={{ etcd_scheme }}://{{ node.ip }}:{{ node.peer_port }}
  {%- if not loop.last %},{% endif %}
  {%- endfor %}

# new    — создаём новый кластер (первый запуск)
# existing — добавляем ноду в уже работающий кластер
initial-cluster-state: '{{ etcd_initial_cluster_state }}'

# ----------------------------------------------------------
# Настройки производительности (оставляем дефолт для обучения)
# ----------------------------------------------------------

# Интервал между heartbeat-сообщениями лидера (мс)
heartbeat-interval: {{ etcd_heartbeat_interval }}

# Таймаут после которого follower инициирует выборы нового лидера (мс)
# Должен быть в 5-10 раз больше heartbeat-interval
election-timeout: {{ etcd_election_timeout }}

{% if etcd_tls_enabled %}
# ----------------------------------------------------------
# TLS (mutual)
#
# peer-transport-security   — шифрование и взаимная аутентификация между
#                             etcd-нодами (raft). client-cert-auth=true —
#                             нода принимает только серты, подписанные нашим CA.
# client-transport-security — то же для клиентов (Patroni, etcdctl): каждый
#                             клиент обязан предъявить серт от нашего CA.
# ----------------------------------------------------------
peer-transport-security:
  cert-file: '{{ etcd_peer_cert }}'
  key-file: '{{ etcd_peer_key }}'
  client-cert-auth: true
  trusted-ca-file: '{{ etcd_ca_cert }}'
  auto-tls: false

client-transport-security:
  cert-file: '{{ etcd_server_cert }}'
  key-file: '{{ etcd_server_key }}'
  client-cert-auth: true
  trusted-ca-file: '{{ etcd_ca_cert }}'
  auto-tls: false
{% endif %}

# ----------------------------------------------------------
# Production-тюнинг
# ----------------------------------------------------------
# Автокомпакция истории ревизий — ограничивает рост backend-БД.
auto-compaction-mode: '{{ etcd_auto_compaction_mode }}'
auto-compaction-retention: '{{ etcd_auto_compaction_retention }}'
# Лимит размера backend-БД (байты).
quota-backend-bytes: {{ etcd_quota_backend_bytes }}
# Порог транзакций между снапшотами.
snapshot-count: {{ etcd_snapshot_count }}
# Уровень метрик Prometheus (/metrics на клиентском порту).
metrics: '{{ etcd_metrics }}'

# ----------------------------------------------------------
# Логирование
# ----------------------------------------------------------
log-level: '{{ etcd_log_level }}'
