#!/usr/bin/env bash
# ============================================================
# pgbackrest-backup.sh — обёртка для регулярных бэкапов (cron)
# Сгенерировано Ansible (роль pgbackrest)
#
# Тип бэкапа передаётся аргументом:
#   full  — полный (полная копия кластера)
#   diff  — разностный (изменения с последнего full)
#   incr  — инкрементальный (изменения с последнего любого бэкапа)
# ============================================================
set -euo pipefail

STANZA="{{ pgbackrest_stanza }}"
TYPE="${1:-incr}"

exec pgbackrest --stanza="$STANZA" --type="$TYPE" backup
